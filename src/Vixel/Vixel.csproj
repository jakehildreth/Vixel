<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Vixel.Core\Vixel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vixel.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- dotnet tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vixel</ToolCommandName>
    <PackageId>Vixel</PackageId>
    <Version>2026.9.230900</Version>
    <!-- AssemblyVersion/FileVersion come from Directory.Build.props; the release
         workflow passes a zero-stripped override. Never hardcode them here. -->
    <Authors>Jake Hildreth</Authors>
    <Company>Gilmour Technologies Ltd</Company>
    <Description>In-terminal pixel drawing app. C#, cross-platform, keyboard-first (vim-modal).</Description>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/jakehildreth/Vixel</RepositoryUrl>
    <PackageTags>pixel-art;tui;terminal;aseprite;piskel;pixquare</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default splash text, overridable via ~/.config/vixel/splash.txt -->
    <EmbeddedResource Include="splash.txt" LogicalName="Vixel.splash.txt" />
  </ItemGroup>

</Project>
