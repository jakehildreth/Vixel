<Project>

  <!--
    Version (CalVer yyyy.M.dHHmm) is set on src/Vixel/Vixel.csproj for the package.
    AssemblyVersion/FileVersion reject 0-prefixed segments, so the release workflow
    passes /p:AssemblyVersion with leading zeros stripped (computed with awk).
    Local dev builds use this default.
  -->
  <PropertyGroup Condition="'$(AssemblyVersion)' == ''">
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
